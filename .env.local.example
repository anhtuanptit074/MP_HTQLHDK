# Chỉ chứa giá trị local giả. Sao chép thành .env.local và tự đặt mật khẩu ngẫu nhiên.
HTQLHDK_ENVIRONMENT=Local
HTQLHDK_DB_HOST=127.0.0.1
HTQLHDK_DB_PORT=54329
HTQLHDK_DB_NAME=htqlhdk_core_local
HTQLHDK_SCHEMA_MODEL=core13
HTQLHDK_DB_ADMIN_USER=htqlhdk_migrator
HTQLHDK_DB_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_VALUE
HTQLHDK_DB_APP_USER=htqlhdk_app
HTQLHDK_DB_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_LOCAL_VALUE
HTQLHDK_OTEL_EXPORTER_ENABLED=false
HTQLHDK_ZAP_ENABLED=false
HTQLHDK_ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:2.17.0@sha256:781a2bdaea47324e7bab583e2263f21d257b0aee61ed51521a5be45f5f5081ef
HTQLHDK_ZAP_DOCKER_NETWORK=bridge
HTQLHDK_ZAP_WORK_ROOT=local-data/zap-work
HTQLHDK_ZAP_ARTIFACT_ROOT=local-data/zap-artifacts
HTQLHDK_ZAP_ARTIFACT_KEY_REF=local-development-only
