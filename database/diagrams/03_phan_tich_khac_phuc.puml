@startuml
hide circle
skinparam linetype polyline
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classBackgroundColor #EFF6FF
skinparam classBorderColor #334155
skinparam ArrowColor #64748B
skinparam nodesep 50
skinparam ranksep 70
left to right direction
title HTQLHDK 2.0 — 03 phan tich khac phuc
entity "Lần quét cụ thể\nscan_occurrence" as scan_occurrence {
  * id : bigint <<PK>>
  * code : varchar 
  * asset_id : bigint <<FK>>
  * scope_id : bigint <<FK>>
  schedule_id : bigint <<FK>>
  * operations_team_id : bigint <<FK>>
  * status : scan_status 
  * target_urls : text_array 
}
entity "Lô nhập và metadata báo cáo ZAP gốc\nimport_batch" as import_batch {
  * id : bigint <<PK>>
  * code : varchar 
  * asset_id : bigint <<FK>>
  * scan_id : bigint <<FK>>
  * file_sha256 : varchar 
  * status : import_status 
  * raw_object_key : text 
}
entity "Phát hiện chuẩn hóa\nfinding" as finding {
  * id : bigint <<PK, FK>>
  * code : varchar 
  * asset_id : bigint <<FK>>
  * fingerprint : varchar 
  * status : finding_status 
  current_review_id : bigint <<FK>>
  verification_result_id : bigint <<FK>>
}
entity "Bằng chứng của phát hiện\nevidence" as evidence {
  * id : bigint <<PK>>
  * finding_id : bigint <<FK>>
}
entity "Đánh giá mức độ và kết luận phát hiện\nfinding_review" as finding_review {
  * id : bigint <<PK>>
  * finding_id : bigint <<FK>>
  * review_kind : text 
  * status : text 
  previous_review_id : bigint <<FK>>
  proposed_severity : final_severity 
  evidence_id : bigint <<FK>>
  trigger_occurrence_id : bigint <<FK>>
}
entity "Thời hạn được phê duyệt theo mức độ\nsla_rule" as sla_rule {
  * id : bigint <<PK>>
  * severity : final_severity 
}
entity "Phiếu khắc phục\nremediation_ticket" as remediation_ticket {
  * id : bigint <<PK, FK>>
  * code : varchar 
  * finding_id : bigint <<FK>>
  current_event_id : bigint <<FK>>
}
entity "Lịch sử phân công, tiến độ và thời hạn phiếu\nticket_event" as ticket_event {
  * id : bigint <<PK>>
  * ticket_id : bigint <<FK>>
  * finding_id : bigint <<FK>>
  previous_event_id : bigint <<FK>>
  team_id : bigint <<FK>>
  assignee_id : bigint <<FK>>
  due_at : timestamptz 
  sla_rule_id : bigint <<FK>>
  evidence_id : bigint <<FK>>
}
entity "Yêu cầu xác minh khắc phục\nverification_request" as verification_request {
  * id : bigint <<PK>>
  * asset_id : bigint <<FK>>
  * finding_id : bigint <<FK>>
  * ticket_id : bigint <<FK>>
  * scope_id : bigint <<FK>>
  * remediation_event_id : bigint <<FK>>
  * operations_team_id : bigint <<FK>>
  * status : text 
}
entity "Kết quả đánh giá xác minh\nverification_result" as verification_result {
  * id : bigint <<PK>>
  * request_id : bigint <<FK>>
  * finding_id : bigint <<FK>>
  * asset_id : bigint <<FK>>
  * scan_id : bigint <<FK>>
  batch_id : bigint <<FK>>
}
scan_occurrence ||--o{ import_batch
finding_review |o--o| finding
verification_result |o--o| finding
finding ||--o{ evidence
finding ||--o{ finding_review
finding_review |o--o{ finding_review
evidence |o--o{ finding_review
finding ||--o{ remediation_ticket
ticket_event |o--o| remediation_ticket
remediation_ticket ||--o{ ticket_event
ticket_event |o--o{ ticket_event
sla_rule |o--o{ ticket_event
evidence |o--o{ ticket_event
finding ||--o{ verification_request
remediation_ticket ||--o{ verification_request
ticket_event ||--o{ verification_request
verification_request ||--o{ verification_result
scan_occurrence ||--o{ verification_result
import_batch |o--o{ verification_result
@enduml
