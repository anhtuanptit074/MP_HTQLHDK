        boolean is_active
    }
    user_role {
        bigint id PK
        bigint user_id FK
        varchar role_code
        bigint asset_id FK
        bigint granted_by FK
        bigint revoked_by FK
    }
    asset {
        bigint id PK
        varchar code UK
        text base_url
        bigint owner_id FK
        bigint security_officer_id FK
        varchar status
        bigint created_by FK
    }
    asset_scope_revision {
        bigint id PK
        bigint asset_id FK
        integer version_no UK
        varchar status
        timestamptz effective_from
        timestamptz effective_until
    }
    asset_scope_rule {
        bigint id PK
        bigint scope_id FK
        varchar effect
        varchar target_type
        text target_value
        varchar match_mode
    }
    asset_scan_window {
        bigint id PK
        bigint scope_id FK
        smallint weekday_iso
        time start_time
        time end_time
        text timezone
    }
    zap_scan_profile {
        bigint id PK
        varchar code UK
        integer version_no UK
        varchar status
        boolean active_scan_enabled
        bigint service_user_id FK
    }
    scan_plan {
        bigint id PK
        varchar code UK
        integer version_no UK
        varchar plan_kind
        bigint scope_id FK
        bigint zap_profile_id FK
        bigint operator_id FK
        bigint remediation_ticket_id FK
        varchar status
    }
    scan_run {
        bigint id PK
        bigint plan_id FK
        varchar code UK
        timestamptz scheduled_for UK
        varchar scan_status
        varchar report_status
        text report_object_key
        char report_sha256
        varchar verification_outcome
        bigint evaluated_by FK
    }
    finding {
        bigint id PK
        bigint asset_id FK
        varchar code UK
        char fingerprint UK
        varchar final_severity
        varchar status
        bigint assessed_by FK
        bigint decision_by FK
    }
    finding_occurrence {
        bigint id PK
        bigint finding_id FK
        bigint scan_run_id FK
        text record_locator UK
        varchar source_severity
        smallint source_confidence
    }
    remediation_ticket {
        bigint id PK
        bigint finding_id FK,UK
        varchar code UK
        bigint assignee_id FK
        bigint assigned_by FK
        timestamptz due_at
        smallint progress_percent
    }
    audit_log {
        bigint id PK
        bigint actor_id FK
        varchar actor_kind
        varchar action
        varchar object_type
        text object_id
        uuid correlation_id
    }

