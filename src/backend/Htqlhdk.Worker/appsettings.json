{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "Htqlhdk": {
    "Environment": "Unspecified",
    "JobsEnabled": false,
    "ZapAutomation": {
      "Enabled": false,
      "DatabaseConnectionStringEnvironmentVariable": "HTQLHDK_DATABASE_URL",
      "ImageReference": "ghcr.io/zaproxy/zaproxy:2.17.0@sha256:781a2bdaea47324e7bab583e2263f21d257b0aee61ed51521a5be45f5f5081ef",
      "DockerExecutable": "docker",
      "DockerNetwork": "bridge",
      "WorkRoot": "local-data/zap-work",
      "ArtifactRoot": "local-data/zap-artifacts",
      "ArtifactKeyReference": "local-development-only",
      "PollIntervalSeconds": 10,
      "LeaseSeconds": 120,
      "HeartbeatSeconds": 30,
      "DispatchBatchSize": 5,
      "MemoryLimit": "2g",
      "CpuLimit": "2",
      "MaxReportBytes": 52428800,
      "CleanupWorkDirectory": true
    }
  }
}
