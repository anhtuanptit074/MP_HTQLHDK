@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam rectangleBackgroundColor white
skinparam rectangleBorderColor #334155
skinparam databaseBackgroundColor white
skinparam databaseBorderColor #334155
skinparam ArrowColor #475569
left to right direction
title Sơ đồ luồng dữ liệu mức 1 — HTQLHDK tích hợp ZAP tự động

actor "Chủ sở hữu\ntài sản" as OWNER
actor "Chuyên viên\nATTT" as SECURITY
actor "Nhóm vận hành\ntích hợp" as OPS
actor "Nhóm khắc phục\nkỹ thuật" as REMEDY
actor "Người phê duyệt\nrủi ro" as RISK
cloud "OWASP ZAP" as ZAP

rectangle "P1\nQuản lý tài sản\nvà phạm vi" as P1
rectangle "P2\nLập lịch và\nđiều phối ZAP" as P2
rectangle "P3\nTiếp nhận, kiểm tra\nvà chuẩn hóa báo cáo" as P3
rectangle "P4\nPhân tích, khắc phục\nvà xác minh" as P4

database "D1\nNgười dùng, nhóm, phạm vi quyền,\naudit và thông báo" as D1
database "D2\nTài sản, phạm vi,\nhồ sơ ZAP và lịch" as D2
database "D3\nLần quét, phiên ZAP,\nartifact và lô tiếp nhận" as D3
database "D4\nPhát hiện, đánh giá, phiếu,\nbằng chứng và rủi ro" as D4

OWNER --> P1 : khai báo / xác nhận
SECURITY --> P1 : phê duyệt phạm vi
P1 --> D2 : asset + scope

SECURITY --> P2 : lịch / hồ sơ
OPS --> P2 : cấu hình / ngoại lệ
D2 --> P2 : scope + profile
P2 --> ZAP : plan / chạy / dừng
ZAP --> P2 : tiến độ / báo cáo
P2 --> D3 : scan + execution

D3 --> P3 : báo cáo gốc
P3 --> D3 : checksum / lỗi nhập
P3 --> D4 : finding chuẩn hóa
P3 --> OPS : lỗi tiếp nhận

SECURITY --> P4 : severity / đóng mở
REMEDY --> P4 : tiến độ / bằng chứng
RISK --> P4 : quyết định rủi ro
P4 --> D4 : review / ticket / risk
P4 --> P2 : yêu cầu quét xác minh

D1 ..> P1 : kiểm quyền + audit
D1 ..> P2 : kiểm quyền + audit
D1 ..> P3 : kiểm quyền + audit
D1 ..> P4 : kiểm quyền + audit
@enduml
