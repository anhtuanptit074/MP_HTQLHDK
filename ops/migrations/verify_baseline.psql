\set ON_ERROR_STOP on

DO $$
DECLARE
    business_table_count integer;
    expected_table_count integer;
BEGIN
    -- V002 extends the baseline. Re-running verification must preserve that schema.
    SELECT CASE WHEN EXISTS (
        SELECT 1 FROM htqlhdk_migration.schema_migration
        WHERE version = 'V002' AND status = 'Applied'
    ) THEN 30 ELSE 27 END INTO expected_table_count;

    SELECT count(*) INTO business_table_count
    FROM information_schema.tables
    WHERE table_schema = 'htqlhdk' AND table_type = 'BASE TABLE';

    IF business_table_count <> expected_table_count THEN
        RAISE EXCEPTION 'Expected % HTQLHDK tables, found %', expected_table_count, business_table_count;
    END IF;

    IF NOT EXISTS (
        SELECT 1 FROM htqlhdk_migration.schema_migration
        WHERE version = 'V001' AND status = 'Applied' AND applied_at IS NOT NULL
    ) THEN
        RAISE EXCEPTION 'Migration V001 is not recorded as Applied';
    END IF;

    IF current_setting('TimeZone') <> 'UTC' THEN
        RAISE EXCEPTION 'Database session timezone must be UTC, found %', current_setting('TimeZone');
    END IF;
END $$;

SELECT 'PASS: V001 applied; table count matches applied migrations; timezone UTC.' AS result;
